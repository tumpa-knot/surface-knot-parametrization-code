  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"t", "^", "4"}], "-", 
       RowBox[{"4", 
        RowBox[{"t", "^", "2"}]}]}], ")"}]}], "+", "3"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"NRoots", "[", 
  RowBox[{
   RowBox[{"H", "[", "t", "]"}], ",", "t"}], "]"}], "\[IndentingNewLine]", 
