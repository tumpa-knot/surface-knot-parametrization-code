Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Polynomial", " ", "parameterization", " ", "of", " ", "the", " ", "long", 
    " ", "knot", " ", "K", " ", "given", " ", "by", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"f", 
       RowBox[{"(", "t", ")"}]}], ",", " ", 
      RowBox[{"g", 
       RowBox[{"(", "t", ")"}]}], ",", " ", 
      RowBox[{"h", 
       RowBox[{"(", "t", ")"}]}]}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "t_", "]"}], "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"t", "^", "3"}], "-", 
     RowBox[{"3", "t"}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "t_", "]"}], "=", 
